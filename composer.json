{
  "name": "oblak/srbtranslatin",
  "description": "Serbian Cyrillic and Latin script support for WordPress.",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.4.1 <8.5",
    "automattic/jetpack-autoloader": "^6.0.2",
    "oblak/transliterator": "^3.1.0",
    "oblak/wp-plugin-installer": "^2.1.8",
    "symfony/css-selector": "^8.1.10",
    "voku/simple_html_dom": "^5.1.0",
    "x-wp/di": "^1.10.0"
  },
  "require-dev": {
    "oblak/wordpress-coding-standard": "^1.3.0",
    "php-stubs/wordpress-stubs": "^7.1.2",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.3.4",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "phpunit/phpunit": "^9.6",
    "swissspidy/phpstan-no-private": "^1.0.0",
    "symfony/var-dumper": "^8.1.10",
    "szepeviktor/phpstan-wordpress": "^2.0.4",
    "wp-cli/wp-cli": "^2.12.0",
    "x-wp/whoops": "^1.1.2",
    "yoast/phpunit-polyfills": "^4.0.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Oblak\\STL\\": "lib",
      "STL\\Common\\": "src/Common/",
      "STL\\": "src/Modules/"
    },
    "classmap": [
      "src/App.php",
      "lib/"
    ]
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    },
    "allow-plugins": {
      "automattic/jetpack-autoloader": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:clean": "bash bin/clean-wp-tests.sh",
    "test:env:start": "podman compose up -d mysql",
    "test:env:stop": "podman compose down --remove-orphans",
    "test:install": [
      "@test:env:start",
      "bash bin/install-wp-tests.sh"
    ]
  }
}
