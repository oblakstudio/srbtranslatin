{
    "scripts": {
        "build": "npm run build:production",
        "build:production": "wp-scripts build assets/blocks/script-selector/src/index.js --output-path=assets/blocks/script-selector/build && cp assets/blocks/script-selector/src/block.json assets/blocks/script-selector/build/block.json",
        "semantic-release": "semantic-release",
        "start": "npm run start:block",
        "start:block": "wp-scripts start assets/blocks/script-selector/src/index.js --output-path=assets/blocks/script-selector/build",
        "test:package": "node --test scripts/package.test.mjs"
    },
    "devDependencies": {
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@semantic-release/wordpress": "^1.6.6",
        "@wordpress/block-editor": "^19.0.0",
        "@wordpress/blocks": "^17.0.0",
        "@wordpress/components": "^43.0.0",
        "@wordpress/element": "^10.0.0",
        "@wordpress/i18n": "^7.0.0",
        "@wordpress/scripts": "^37.0.0",
        "@wordpress/server-side-render": "^7.0.0",
        "ajv": "^8.20.0",
        "semantic-release": "^25.0.9"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    }
}
